// Configuration Cloudflare du site "veille-patrimoine"
// Ce fichier ne contient AUCUN secret : les clés sont dans le coffre GitHub.
{
  "name": "veille-patrimoine",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  // Les pages du site. "run_worker_first" oblige chaque visite à passer
  // d'abord par le contrôle de connexion (src/index.js).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // La base de données (comptes, sessions, puis articles et briefs).
  // L'identifiant n'est pas secret : il est inutilisable sans le jeton Cloudflare.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veille-db",
      "database_id": "76538af6-789e-455d-bcd5-b38020bc29cb",
      "migrations_dir": "migrations"
    }
  ],

  // Toutes les 15 minutes : lance le robot de collecte sur GitHub (voir src/index.js, declencherRobot).
  "triggers": { "crons": ["3,18,33,48 * * * *"] }
}
